{
	"name": "linkaboard",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^5",
			"@types/bun": "^1.3.4",
			"elysia": "^1.4.21",
			"@trpc/server": "^11.7.2",
			"better-auth": "^1.4.9",
			"@trpc/tanstack-react-query": "^11.7.2",
			"@trpc/client": "^11.7.2",
			"@tanstack/react-query": "^5.90.12",
			"alchemy": "^0.82.1",
			"@better-auth/expo": "^1.4.9"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @linkaboard/db db:push",
		"db:studio": "turbo -F @linkaboard/db db:studio",
		"db:generate": "turbo -F @linkaboard/db db:generate",
		"db:migrate": "turbo -F @linkaboard/db db:migrate",
		"deploy": "turbo -F @linkaboard/infra deploy",
		"destroy": "turbo -F @linkaboard/infra destroy",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@linkaboard/env": "workspace:*",
		"@sinclair/typebox": "^0.34.48",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@cloudflare/workers-types": "^4.20251213.0",
		"@linkaboard/config": "workspace:*",
		"@types/bun": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"turbo": "^2.6.3",
		"typescript": "catalog:"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.3"
}
